# Application Environment
NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tellme_dev

# Redis (Upstash / Local)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tellme-media
R2_PUBLIC_URL=https://media.tellme.app

# Auth Secrets
AUTH_SECRET=tellme_super_secret_session_key_minimum_32_characters

# Push Notification (FCM / Expo)
EXPO_ACCESS_TOKEN=
