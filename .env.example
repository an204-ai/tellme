# Sao chép thành .env tại thư mục gốc. Chỉ có một file cấu hình cho toàn workspace.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=tellme
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
GIPHY_API_KEY=replace_me
# OpenWeather Free: Current Weather + 5 day / 3 hour forecast. Chỉ dùng ở server.
OPENWEATHER_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
APP_URL=http://127.0.0.1:3000
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NODE_ENV=development
# Danh sách email quản trị cách nhau bằng dấu phẩy; để trống sẽ không cấp quyền admin.
ADMIN_EMAILS=
ADMIN_APP_URL=http://127.0.0.1:3001
MEDIA_ORPHAN_HOURS=24
# Gmail: bật 2-Step Verification và tạo App Password. Không dùng mật khẩu đăng nhập Google.
# SMTP_URL=smtps://YOUR_GMAIL%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# EMAIL_FROM=Tellme <YOUR_GMAIL@gmail.com>
# SMTP chỉ gửi xác thực email, đặt lại mật khẩu và thông báo đổi mật khẩu.
# Thông báo tương tác dùng in-app + Web Push.
SMTP_URL=
EMAIL_FROM=Tellme <hello@tellme.local>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@tellme.local

# Khóa riêng server để bảo vệ mã khôi phục 6 số; tạo bằng node crypto.randomBytes(32).
AUTH_CODE_SECRET=

# Epidemic Sound Free API: local prototyping only (not a production licence).
EPIDEMIC_SOUND_API_KEY=

# YouTube Data API v3: primary music search, server-only key.
YOUTUBE_API_KEY=
