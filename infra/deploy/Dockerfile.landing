FROM node:22-bookworm-slim AS build
WORKDIR /workspace/tellme-landing
RUN corepack enable
COPY tellme-landing/ ./
ARG NEXT_PUBLIC_SITE_URL=https://about.tellme.my
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN pnpm install --frozen-lockfile && pnpm build

FROM nginx:1.30-alpine
COPY infra/deploy/nginx/landing.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/tellme-landing/out /usr/share/nginx/html
EXPOSE 80
