FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter @tellme/admin...
RUN pnpm --filter @tellme/admin build

FROM nginx:1.30-alpine
COPY infra/deploy/nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY infra/deploy/nginx/api-proxy-params.conf /etc/nginx/tellme-api-proxy-params.conf
COPY --from=build /workspace/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
