{
  "name": "@tellme/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8",
    "bullmq": "^5.29.1",
    "ioredis": "^5.4.1",
    "cloudinary": "^2.11.0",
    "sharp": "^0.33.5",
    "blurhash": "^2.0.5",
    "nodemailer": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tellme/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
